{
  "expo": {
    "name": "HomeCycle",
    "slug": "homecycle",
    "scheme": "homecycle",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./src/assets/images/logo-icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./src/assets/images/logo-icon.png"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#5F9495",
        "foregroundImage": "./src/assets/images/logo-icon.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.anonymous.temp_setup"
    },
    "web": {
      "output": "static",
      "favicon": "./src/assets/images/logo-favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#5F9495",
          "image": "./src/assets/images/logo-icon-light-transparent.png",
          "imageWidth": 160,
          "resizeMode": "contain"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "b969e108-fdf7-43b3-a720-3b4c4afc6b03"
      }
    }
  }
}